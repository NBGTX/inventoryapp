<Window x:Class="SpPerm.App.ChooseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose" Width="460" Height="420" MinWidth="380" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Arial" FontSize="12" Background="{StaticResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Margin="0,0,0,12" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource DarkBrush}"/>
        <ListBox x:Name="List" Grid.Row="1" BorderBrush="{StaticResource BorderBrushSoft}" MouseDoubleClick="OnConfirm"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90"/>
            <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnConfirm" MinWidth="120"/>
        </StackPanel>
    </Grid>
</Window>
