<UserControl x:Class="SpPerm.App.MatrixView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="13" Height="13" Background="{StaticResource DarkBrush}" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Full" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Width="13" Height="13" Background="{StaticResource MediumBrush}" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Edit, Contribute" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Width="13" Height="13" Background="{StaticResource LightBrush}" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Read" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Width="13" Height="13" Background="White" BorderBrush="{StaticResource MediumBrush}" BorderThickness="1.5" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Outlined = inherited" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Width="13" Height="13" Background="White" BorderBrush="#E0A100" BorderThickness="2.5" CornerRadius="2" Margin="0,0,4,0"/>
                <TextBlock Text="Pending" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource ChipRadio}" Content="By folder" GroupName="mm"
                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=0, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource ChipRadio}" Content="By person" GroupName="mm" Margin="0,0,16,0"
                             IsChecked="{Binding Mode, Converter={StaticResource Equals}, ConverterParameter=1, Mode=TwoWay}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Library" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" MinWidth="170" Margin="0,0,12,0"/>
                    <TextBox Width="170" Text="{Binding PeopleFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter the people and groups shown as columns"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <TextBlock Grid.Row="1" Margin="2,8,0,8" FontSize="11" Foreground="{StaticResource MutedBrush}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{Binding ColumnsNote}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="1">
                            <Setter Property="Text" Value="{Binding PersonNote}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <DataGrid x:Name="MatrixGrid" ItemsSource="{Binding Rows}" RowHeight="40" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Folder" Width="290">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource MediumBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                                    <Border Margin="7,0,0,0" Padding="5,1" CornerRadius="3" Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{Binding BadgeForeground}"/>
                                    </Border>
                                    <Button Content="Reset" Style="{StaticResource LinkButton}" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                            Command="{Binding ResetCommand}" Visibility="{Binding ResetVisibility}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode}" Value="1">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Person or group" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}"/>
                <ComboBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" DisplayMemberPath="Title" MinWidth="320"/>
            </StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding PersonRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Folder or file" Binding="{Binding Path}" Width="*"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="110"/>
                    <DataGridTextColumn Header="Permission level" Binding="{Binding Level}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,8,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   Text="Click a cell to choose a permission level. Changes are queued, and nothing is applied until you review and apply them."/>
    </Grid>
</UserControl>
